{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability shared by every sticky-note window (windows are labeled by note id, not a fixed name)",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "opener:default"
  ]
}
